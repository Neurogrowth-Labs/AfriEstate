# Use a server-side AI gateway in production. The gateway owns provider keys and
# proxies POST /chat/completions requests to OpenRouter.
VITE_AI_GATEWAY_URL=https://your-ai-gateway.example.com

# Local-development fallbacks only. Never publish either value in a production
# browser bundle; configure the gateway with OPENROUTER_API_KEY and GEMINI_API_KEY instead.
VITE_OPENROUTER_API_KEY=
VITE_GEMINI_API_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set only for local demos where offline mock fallbacks are desired.
VITE_DEMO_MODE=false
